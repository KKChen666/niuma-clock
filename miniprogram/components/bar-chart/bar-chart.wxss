.chart-scroll { width: 100%; white-space: nowrap; }
.chart-inner { display: flex; align-items: flex-end; padding: 8rpx 24rpx 0; }
.chart-col {
  display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
  width: 60rpx;
  margin-right: 16rpx;
  flex: none;
}
.chart-value { font-size: 18rpx; color: var(--text-secondary); margin-bottom: 6rpx; }
.chart-bar {
  width: 100%;
  min-height: 4rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: var(--accent-blue);
  opacity: .86;
  transition: height 320ms ease, background 200ms ease, opacity 150ms ease;
}
.chart-value, .chart-label { transition: opacity 150ms ease; }
.chart-bar.is-zero { background: var(--ring-gray); }
.chart-label { font-size: 20rpx; color: var(--text-secondary); margin-top: 8rpx; }
