.week-strip { display: flex; padding: 24rpx 10rpx 20rpx; }
.ws-col {
  flex: 1;
  display: flex; flex-direction: column; align-items: center;
  padding: 10rpx 0 8rpx;
  border-radius: 16rpx;
}
.ws-col.is-selected { background: var(--accent-blue-bg); }
.ws-track {
  width: 24rpx; height: 104rpx;
  display: flex; align-items: flex-end;
  border-radius: 999rpx;
  background: var(--ring-gray);
  overflow: hidden;
}
.ws-bar {
  width: 100%;
  min-height: 6rpx;
  border-radius: 999rpx;
  background: var(--accent-blue);
  transition: height 500ms ease;
}
.ws-col.is-today .ws-bar { background: var(--accent-amber); box-shadow: var(--glow-amber); }
.ws-label { font-size: 22rpx; color: var(--text-secondary); margin-top: 10rpx; }
.ws-col.is-today .ws-label { color: var(--accent-amber); font-weight: 700; }
