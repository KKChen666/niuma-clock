.entry-anchor { margin-bottom: 20rpx; }
.entry-fold {
  display: flex; align-items: center; justify-content: center;
  min-height: 72rpx;
  border: 2rpx dashed var(--ring-gray);
  border-radius: 24rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  letter-spacing: 2rpx;
  background: var(--bg-card);
}
.entry-fold text:first-child { margin-right: 12rpx; font-size: 28rpx; }
.entry-body { margin-top: 20rpx; }
.entry-hint { display: block; font-size: 24rpx; line-height: 1.6; color: var(--text-secondary); margin-bottom: 20rpx; }
.form-label { display: block; }

.segmented {
  display: flex;
  padding: 6rpx;
  border-radius: 20rpx;
  background: var(--accent-blue-bg);
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  border-radius: 16rpx;
}
.seg-item.is-active { background: var(--bg-card); color: var(--accent-blue); font-weight: 600; box-shadow: var(--shadow-sm); }

.time-row { display: flex; align-items: center; }
.time-row picker { flex: 1; min-width: 0; }
.shift-sep { padding: 0 16rpx; color: var(--text-tertiary); }

.chip-row { display: flex; align-items: center; flex-wrap: wrap; margin-bottom: 20rpx; }
.chip-label { font-size: 24rpx; color: var(--text-secondary); margin-right: 16rpx; }
.chip { padding: 8rpx 20rpx; font-size: 24rpx; margin-right: 12rpx; margin-bottom: 8rpx; }

.dur-preview {
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  background: var(--accent-blue-bg);
  border: 2rpx dashed var(--border-soft);
  border-radius: 24rpx;
}
.dur-preview.has-value { background: var(--accent-amber-bg); border-color: var(--accent-amber); border-style: solid; }
.dur-strong { font-size: 36rpx; font-weight: 800; color: var(--accent-amber); }
.dur-text { margin-left: 8rpx; }

.entry-actions { display: flex; }
.entry-actions .btn { flex: 1; margin-right: 16rpx; }
.entry-actions .btn:last-child { margin-right: 0; flex: 0 0 30%; }
.btn-save { box-shadow: var(--btn-3d); border-radius: 999rpx; }
