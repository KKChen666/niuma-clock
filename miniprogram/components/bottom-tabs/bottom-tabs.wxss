/* 通栏贴底 dock（对齐微信 tabBar）：
   背景铺满整个宽度并一直延伸到屏幕最底部，安全区也由同一底色覆盖，
   图标在上、文字在下；不再用左右留白的悬浮胶囊。

   图标：双态 SVG（线性 / 填充）经 CSS mask 上色，颜色跟随 currentColor
   （即 var(--text-secondary) → var(--accent-blue)），亮暗主题自动适配。
   切换时线性层淡出、填充层以「图标动画库」式弹性动效弹入（每个图标
   一套专属关键帧：打卡上抛、日历摆动、奖杯双弹、数据柱长）。
   注意：@keyframes 必须内联在本文件（WXSS 编译单元隔离，见 README）。
   SVG 源文件在仓库 assets/tab-icons/，base64 mask 由
   scripts/build-tab-icons.mjs 注入下方 @icons 区块，勿手改该区块。 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 12rpx 0 calc(10rpx + env(safe-area-inset-bottom));
  background: var(--tabbar-bg);
  border-top: 2rpx solid var(--border-soft);
  box-shadow: 0 -4rpx 20rpx rgba(45, 55, 72, 0.04);
  transition: background 260ms ease;
  z-index: 30;
}
.tab-segmented {
  display: flex;
  align-items: stretch;
  width: 100%;
  padding: 0;
  background: transparent;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rpx 0;
  color: var(--text-secondary);
  transition: color 180ms ease;
}
.tab-icon {
  position: relative;
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 2rpx;
  border-radius: 30rpx;
  background: transparent;
  transition: background 180ms ease;
}
.tab-label {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.3;
}
.tab-item.is-active { color: var(--accent-blue); }
.tab-item.is-active .tab-icon { background: var(--accent-blue-bg); }
.tab-item.is-active .tab-label { font-weight: 700; }
.tab-hover { opacity: .7; }

/* ---- 双态图标层：mask 上色，currentColor 跟随主题 ---- */
.ic {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: currentColor;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
  transition: opacity 180ms ease, transform 240ms cubic-bezier(.34, 1.56, .64, 1);
}
.ic-show { opacity: 1; transform: scale(1); }
.ic-hide { opacity: 0; transform: scale(.55); }

/* 激活弹入：每个图标一套专属动效（useAnimations 风格） */
.ic-play.ic-record { animation: ic-anim-record 360ms cubic-bezier(.34, 1.56, .64, 1) both; }
.ic-play.ic-calendar { animation: ic-anim-calendar 380ms cubic-bezier(.34, 1.56, .64, 1) both; }
.ic-play.ic-niuma { animation: ic-anim-niuma 480ms cubic-bezier(.34, 1.56, .64, 1) both; }
.ic-play.ic-data { animation: ic-anim-data 360ms cubic-bezier(.34, 1.56, .64, 1) both; }

/* 打卡：像笔尖落下——带倾角上抛入位 */
@keyframes ic-anim-record {
  0% { opacity: 0; transform: translateY(10rpx) rotate(-10deg) scale(.6); }
  55% { opacity: 1; transform: translateY(-4rpx) rotate(3deg) scale(1.14); }
  100% { opacity: 1; transform: translateY(0) rotate(0) scale(1); }
}
/* 日历：页角翻动——小幅摆动两次 */
@keyframes ic-anim-calendar {
  0% { opacity: 0; transform: scale(.5) rotate(0); }
  40% { opacity: 1; transform: scale(1.16) rotate(-9deg); }
  65% { transform: scale(1.02) rotate(6deg); }
  85% { transform: scale(1.04) rotate(-2deg); }
  100% { opacity: 1; transform: scale(1) rotate(0); }
}
/* 牛马：举杯庆祝——双弹 */
@keyframes ic-anim-niuma {
  0% { opacity: 0; transform: scale(.3) translateY(8rpx); }
  32% { opacity: 1; transform: scale(1.18) translateY(-6rpx); }
  52% { transform: scale(.9) translateY(0); }
  72% { transform: scale(1.08) translateY(-3rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}
/* 数据：柱状生长——自底部长起 */
@keyframes ic-anim-data {
  0% { opacity: 0; transform: scale(.8, .3); }
  55% { opacity: 1; transform: scale(1.02, 1.14); }
  100% { opacity: 1; transform: scale(1, 1); }
}

